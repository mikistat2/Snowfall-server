# --- Database ---
# Either a single URL (Supabase/hosted Postgres: paste the connection string —
# SSL is enabled automatically for supabase.co/.com, neon.tech and render.com
# hosts, or any URL containing sslmode=require)...
#
# SUPABASE: use a POOLER string, not the direct db.<ref>.supabase.co host —
# the direct host is IPv6-only and Render dials out over IPv4.
#   postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# Port 5432 is session mode (what Knex and the migrations want). Port 6543 is
# transaction mode and drops session state between statements — do not use it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gym_management
# ...or discrete parts (used only when DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gym_management

# Run pending migrations automatically on boot (recommended for Render).
AUTO_MIGRATE=true

# --- Server ---
PORT=4000
# Allowed browser origins — comma-separated list is supported, e.g.
# CLIENT_URL=https://snowfall.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# --- Auth (use long random strings in production) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Platform admin (the /platform control panel for the product owner) ---
# The panel is DISABLED until a password is set. Use a long random password.
PLATFORM_ADMIN_EMAIL=miki123mbt@gmail.com
PLATFORM_ADMIN_PASSWORD=

# --- Feedback email (Gmail SMTP) ---
# SMTP_USER: a Gmail address that will SEND the feedback mail.
# SMTP_PASS: a Gmail App Password (16 chars, needs 2-Step Verification on that
#            account) — NOT the normal password. See:
#            https://myaccount.google.com/apppasswords
# FEEDBACK_TO: where feedback is delivered (defaults to the product owner).
SMTP_USER=
SMTP_PASS=
FEEDBACK_TO=miki123mbt@gmail.com

# --- Receipt verification (subscription payments) ---
# Gyms pay their platform subscription by bank/wallet transfer and prove it by
# pasting a transaction ID or uploading a receipt screenshot. The server looks
# the transaction up with this API.
#
# The key NEVER reaches the browser — every lookup goes out from the server and
# the platform panel is told only whether a key is present. Until VERIFY_API_KEY
# is set, the billing page tells gyms that payment is unavailable rather than
# letting them send money we cannot check.
#
# The timeout is long on purpose: these calls hit a bank upstream. Retries apply
# only to transport-level trouble (network error, 5xx, 429) — a 4xx is a real
# answer and each retry would burn another paid credit for the same result.
# Veritas. Their docs quote api.veritas.et in one curl example, but that name
# does not resolve — this is the host that answers.
VERIFY_API_URL=https://verifyapi.leulzenebe.pro
VERIFY_API_KEY=
VERIFY_TIMEOUT_MS=30000
VERIFY_RETRIES=2
# Keep the provider's full payload on the payment row for support. It contains
# the payer's full account number and is hidden from every API response.
VERIFY_STORE_RAW=true

# Shared secret for POST /tasks/daily (external daily scheduler).
# Unset = the endpoint is disabled. Must match the GitHub Actions secret.
TASKS_SECRET=
