# --- Database ---
# Either a single URL (Neon/hosted Postgres: paste the connection string —
# SSL is enabled automatically when it contains sslmode=require)...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gym_management
# ...or discrete parts (used only when DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gym_management

# Run pending migrations automatically on boot (recommended for Render).
AUTO_MIGRATE=true

# --- Server ---
PORT=4000
# Allowed browser origins — comma-separated list is supported, e.g.
# CLIENT_URL=https://snowfall.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# --- Auth (use long random strings in production) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Platform admin (the /platform control panel for the product owner) ---
# The panel is DISABLED until a password is set. Use a long random password.
PLATFORM_ADMIN_EMAIL=miki123mbt@gmail.com
PLATFORM_ADMIN_PASSWORD=

# --- Feedback email (Gmail SMTP) ---
# SMTP_USER: a Gmail address that will SEND the feedback mail.
# SMTP_PASS: a Gmail App Password (16 chars, needs 2-Step Verification on that
#            account) — NOT the normal password. See:
#            https://myaccount.google.com/apppasswords
# FEEDBACK_TO: where feedback is delivered (defaults to the product owner).
SMTP_USER=
SMTP_PASS=
FEEDBACK_TO=miki123mbt@gmail.com
